#!/bin/bash
# Java parameter test executable

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# When installed, script is at: install/jros2_interop_tests/lib/jros2_interop_tests/
# Need to go up to workspace root: ../../../..
WORKSPACE_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"

# Build directory contains the classpath file generated by Gradle
BUILD_DIR="$WORKSPACE_ROOT/build"

# Read classpath from generated file
CLASSPATH_FILE="$BUILD_DIR/classpath.txt"
if [ ! -f "$CLASSPATH_FILE" ]; then
    echo "ERROR: Classpath file not found: $CLASSPATH_FILE"
    echo "Please run './gradlew build' first"
    exit 1
fi
CLASSPATH=$(cat "$CLASSPATH_FILE")

# Read native library path from generated file
NATIVE_LIB_PATH_FILE="$BUILD_DIR/native-lib-path.txt"
if [ -f "$NATIVE_LIB_PATH_FILE" ]; then
    LIBRARY_PATH=$(cat "$NATIVE_LIB_PATH_FILE")
else
    LIBRARY_PATH=""
fi

# Run the Java test
exec java -cp "$CLASSPATH" \
    ${LIBRARY_PATH:+-Djava.library.path="$LIBRARY_PATH"} \
    us.ihmc.jros2.interop.JavaParameterTest \
    "$@"
