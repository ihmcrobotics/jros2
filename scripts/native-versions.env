# Pinned versions and checksums of everything the jros2 native libraries are built from.
# Sourced (plain KEY=value lines, no expansions) by scripts/docker/build-natives.sh and scripts/cppbuild.bash.
# Changing anything here invalidates the per-platform dependency caches of the Docker build.

# eProsima Fast-DDS (tag v3.6.2) and the submodules it pins at that commit.
FASTDDS_VERSION=3.6.2
FASTDDS_COMMIT=39303846fb8534ef69fa65f9fa4bcc9e6a7c995a
FASTDDS_SHA256=bedecca2b1804efb69ade775de18bf8031d07698b7b8420f84b6609e92ac3b2c
ASIO_COMMIT=ed6aa8a13d51dfc6c00ae453fc9fb7df5d6ea963
ASIO_SHA256=9d4619e1ea963d3c72c8dc07d5d8c9c4fab67141990b4f8cb10e5d8ad2c83f42
TINYXML2_COMMIT=8c8293ba8969a46947606a93ff0cb5a083aab47a
TINYXML2_SHA256=17995f6508c54c296f07c8fa661cc3f25927a2b0855cf9b0d50b8c6993a63acb
ANDROID_IFADDRS_COMMIT=7b1ce82817226e481d3cda0a5d06b66ebcc211f8
ANDROID_IFADDRS_SHA256=08fc5c48435e63fa6e5db52f5bcfeef8c149b2c41c21e8040a8f7b6322b8d85b

# eProsima Fast-CDR (tag v2.3.5). SONAME libfastcdr.so.2.
FASTCDR_VERSION=2.3.5
FASTCDR_SHA256=e0af6cde06c4a43d90fa905c6d15721435520a26f0ba168ed13dfda45d164001

# foonathan_memory_vendor 1.4.1 is a thin wrapper that git-clones eProsima/memory at tag vendor-1.4.1 and builds it
# as a static PIC library. Both build scripts build that exact commit (FOONATHAN_MEMORY_COMMIT) from a checksummed
# tarball instead, with the library options the vendor package passes (no network access inside the container).
# FOONATHAN_VENDOR_VERSION names the source directory; FOONATHAN_VENDOR_SHA256 documents the wrapper release.
FOONATHAN_VENDOR_VERSION=1.4.1
FOONATHAN_VENDOR_SHA256=bf44910e4f12f58c20274acdd130e55d60be0e42b8c1ef3a559c37d0eecc9acb
FOONATHAN_MEMORY_COMMIT=1de8562aa2b8241ca3d562ddc6d1e9a5cfc07e94
FOONATHAN_MEMORY_SHA256=6fb36181aa28e79fc18b3c095e084b941452352858dc0f2cdc14ec0b6260963b

# OpenSSL 3.5 LTS, linked statically (symbols hidden) into libfastdds for DDS-Security (SROS2).
# Keep ENGINE support (no "no-engine"): Fast-DDS uses it for pkcs11: private keys. OpenSSL 4.x removed engines.
OPENSSL_VERSION=3.5.9
OPENSSL_SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a

# CMake used inside the glibc/Android build image (Alpine uses its own packaged CMake).
CMAKE_VERSION=4.0.2
CMAKE_LINUX_X86_64_SHA256=80940e81de61584fe4eedd3c40adc597d7c5b76ad8709668007b467a3c2a36c7

# Android NDK r30 (2026 LTS). r28+ link arm64-v8a/x86_64 with 16 KB max-page-size by default.
NDK_RELEASE=r30
NDK_REVISION=30.0.16248370
NDK_SHA1=5107f898313790e449e87eee2183d9a20602dee9
NDK_SHA256=753611f410d002cfcd3f3dc2ef49aad532089d3180b436c060a90bf0fcb64df2
ANDROID_API=26

# Oldest macOS the macOS natives support (see scripts/cppbuild.bash for the rationale).
MACOS_DEPLOYMENT_TARGET=12.0

# Fixed timestamp for reproducible builds (OpenSSL embeds its build date). 2026-09-29 = OpenSSL 3.5.9 release.
SOURCE_DATE_EPOCH=1790640000
