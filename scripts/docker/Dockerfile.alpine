# Build image for the musl natives (linux-musl-x86_64, linux-musl-arm64). Builds natively for the image platform:
# build-natives.sh selects linux/amd64 or linux/arm64 (the latter runs under qemu binfmt on an x86_64 host,
# or natively on an arm64 host such as GitHub's ubuntu-24.04-arm runner).
# The digest pins the multi-arch index of alpine:3.24 (3.24.3: musl 1.2.6, gcc 15, cmake 4.2).
FROM alpine:3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

RUN apk add --no-cache bash build-base linux-headers cmake samurai perl file binutils openjdk17-jdk
