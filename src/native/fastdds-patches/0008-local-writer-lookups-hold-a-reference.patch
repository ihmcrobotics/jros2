@@ -1437,6 +1437,24 @@ BaseWriter* RTPSParticipantImpl::find_local_writer(
     return nullptr;
 }
 
+LocalWriterPointer::Instance RTPSParticipantImpl::find_local_writer_instance(
+        const GUID_t& writer_guid)
+{
+    // The instance is taken under the lock: deleteUserEndpoint() erases the writer under this lock before it deactivates
+    // the pointer, so the deactivation waits for this instance.
+    shared_lock<shared_mutex> _(endpoints_list_mutex);
+
+    for (auto writer : m_allWriterList)
+    {
+        if (writer->getGuid() == writer_guid)
+        {
+            return LocalWriterPointer::Instance(writer->get_local_pointer());
+        }
+    }
+
+    return LocalWriterPointer::Instance(std::shared_ptr<LocalWriterPointer>());
+}
